{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "@testing-library/jest-dom"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@vibetech/avatars": ["./packages/avatars/src/index.ts"],
      "@vibetech/avatars/*": ["./packages/avatars/src/*"],
      "@vibetech/games": ["./packages/games/src/index.ts"],
      "@vibetech/games/tutor": ["./packages/games/src/tutor/index.ts"],
      "@vibetech/games/*": ["./packages/games/src/*/index.ts"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*", "src/types/**/*", "electron/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "*.config.ts", "capacitor.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
